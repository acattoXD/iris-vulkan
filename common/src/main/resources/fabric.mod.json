{
  "schemaVersion": 1,
  "id": "iris",
  "version": "${version}",
  "name": "Iris Vulkan (Experimental)",
  "description": "Unofficial experimental Iris fork for Minecraft 26.3 with native Vulkan shader-pack rendering. Compatibility is incomplete. Replaces official Iris; do not install both.",
  "authors": [
    "coderbot",
    "IMS212",
    "Justsnoopy30",
    "FoundationGames"
  ],
  "license": [
    "LGPL-3.0-only",
    "AGPL-3.0-only"
  ],
  "icon": "assets/iris/textures/gui/iris-logo.png",
  "environment": "client",
  "entrypoints": {
    "modmenu": [
      "net.irisshaders.iris.compat.modmenu.ModMenuIntegration"
    ],
    "sodium:config_api_user": [
      "net.irisshaders.iris.compat.sodium.config.IrisConfig"
    ]
  },
  "mixins": [
    "mixins.iris.json",
    "mixins.iris.fabric.json",
    "mixins.iris.vertexformat.json",
    "mixins.iris.bettermipmaps.json",
    "mixins.iris.compat.sodium.json",
    "mixins.iris.compat.dh.json",
    "mixins.iris.fixes.maxfpscrash.json"
  ],
  "accessWidener": "iris.accesswidener",
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "26.3",
    "java": ">=25",
    "sodium": "0.9.2+mc26.3"
  },
  "breaks": {
    "embeddium": "*",
    "iris-explorer": "*",
    "originsenhanced": "<=1.3.2",
    "colormatic": "<=3.0.0",
    "bedrockwaters": "<=1.6.0",
    "batchedentityrendering": "*",
    "canvas": "*",
    "optifabric": "*",
    "worldeditcui": "<1.18.1",
    "physicsmod": "<=3.0.13",
    "distanthorizons": "<=2.1.99",
    "immersive_portals": "<=1.4.2"
  },
  "custom": {
    "sodium:options": {
      "mixin.features.render.world.sky": false
    },
    "mc-publish": {
      "loaders": [
        "fabric"
      ]
    },
    "loom:injected_interfaces": {
      "com/mojang/blaze3d/pipeline/RenderTarget": ["net/irisshaders/iris/mixinterface/RenderTargetInterface"],
      "com/mojang/renderpearl/api/textures/GpuTexture": ["net/irisshaders/iris/mixinterface/GpuTextureInterface"],
      "com/mojang/renderpearl/backend/api/RenderPassBackend": ["net/irisshaders/iris/mixinterface/RenderPassInterface"],
      "com/mojang/renderpearl/api/commands/RenderPass": ["net/irisshaders/iris/mixinterface/RenderPassInterface"],
      "net/minecraft/client/renderer/rendertype/RenderType": ["net/irisshaders/iris/mixinterface/RenderTypeInterface"],
      "net/minecraft/client/renderer/ItemInHandRenderer": ["net/irisshaders/iris/mixinterface/ItemInHandInterface"]
    }
  }
}
